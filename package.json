{
  "name": "react-native-better-pdf-monorepo",
  "private": true,
  "workspaces": [
    "package",
    "example"
  ],
  "scripts": {
    "build": "bun run --filter react-native-better-pdf build",
    "lint": "eslint .",
    "typecheck": "bun run --filter react-native-better-pdf typecheck && bun run --filter better-pdf-example typecheck",
    "specs": "bun run --filter react-native-better-pdf specs",
    "test": "bun run --filter react-native-better-pdf test",
    "fixtures": "node benchmarks/generate-fixtures.mjs",
    "format": "prettier --write .",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.2.14",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jpeg-js": "0.4.4",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
